[Unit]
Description=Travel Recommender Streamlit replica (port %i)
After=network.target

[Service]
Type=simple
User=travel-rec
WorkingDirectory=/opt/travel-recommender
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/travel-recommender/venv/bin/streamlit run app/main.py --server.address 127.0.0.1 --server.port %i --server.headless true
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/travel-recommender/data
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
